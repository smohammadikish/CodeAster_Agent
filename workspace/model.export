# --- Code_Aster Export File ---
P actions make_etude
P debug nodebug
P memjob 4194304
P memory_limit 4096.0
P mode interactif
P mpi_nbcpu 1
P mpi_nbnoeud 1
P ncpus 1
P nomjob beam_analysis
P origine CodeAster_Agent
P server localhost
P time_limit 1800.0
P tpsjob 32
P version stable

A memjeveux 256.0
A tpmax 1800.0

# --- File Associations ---
F comm /Users/amiryarmohamadi/codeaster_agent/workspace/model.comm D 1
F libr /Users/amiryarmohamadi/codeaster_agent/workspace/model.med D 20

# Optional result tables and logs
F mess /Users/amiryarmohamadi/codeaster_agent/workspace/beam_analysis.mess R 6
F resu /Users/amiryarmohamadi/codeaster_agent/workspace/beam_analysis.resu R 80
F libr /Users/amiryarmohamadi/codeaster_agent/workspace/tab_reac.txt R 18
F libr /Users/amiryarmohamadi/codeaster_agent/workspace/tab_disp.txt R 19
F libr /Users/amiryarmohamadi/codeaster_agent/workspace/local_axes.txt R 53
F libr /Users/amiryarmohamadi/codeaster_agent/workspace/tab_sie.txt R 21

# --- Base directory for temporary data ---
R base /Users/amiryarmohamadi/codeaster_agent/workspace/beam_analysis_base R 0
