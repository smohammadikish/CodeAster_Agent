DETRUIRE(CONCEPT = _F(NOM = (tRQ1, tF1dQ1, tDQ1)), INFO=1) 

# ______________ Extracting nodal reactions ________________

# ______________ Extracting internal forces ________________

# _____________ Extracting surface stresses ________________

# __________ Extracting bottom surface stresses ____________

# __________ Extracting middle surface stresses ____________

# ___________ Extracting top surface stresses ______________

