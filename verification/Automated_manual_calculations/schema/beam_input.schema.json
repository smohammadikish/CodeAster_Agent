{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schema/beam_input.schema.json",
  "title": "Beam Analysis Input",
  "description": "Schema for statically determinate 2D beam analysis input files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "beam",
    "supports"
  ],
  "properties": {
    "beam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length"
      ],
      "properties": {
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "section": {
          "type": "object",
          "description": "Free-form section properties. For displacement calculation, provide a positive inertia such as Iz, Izz, Iy, Ix, or I.",
          "default": {},
          "additionalProperties": true
        },
        "material": {
          "type": "object",
          "description": "Free-form material properties. For displacement calculation, provide a positive E.",
          "default": {},
          "additionalProperties": true
        }
      }
    },
    "supports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/support"
      }
    },
    "loads": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/load"
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stations": {
          "type": "integer",
          "minimum": 2,
          "default": 201
        }
      }
    }
  },
  "$defs": {
    "linearValue": {
      "description": "Either a constant scalar value or a linearly varying start/end pair.",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "number"
            },
            "end": {
              "type": "number"
            }
          }
        }
      ]
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "x"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "fixed",
            "fixed_support",
            "pin",
            "pinned",
            "hinge",
            "roller",
            "roller_y",
            "roller_x",
            "free"
          ]
        },
        "x": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "pointForceLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "x"
      ],
      "properties": {
        "type": {
          "const": "point_force"
        },
        "label": {
          "type": "string"
        },
        "x": {
          "type": "number",
          "minimum": 0
        },
        "fx": {
          "type": "number",
          "default": 0
        },
        "fy": {
          "type": "number",
          "default": 0
        }
      }
    },
    "pointMomentLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "x",
        "mz"
      ],
      "properties": {
        "type": {
          "const": "point_moment"
        },
        "label": {
          "type": "string"
        },
        "x": {
          "type": "number",
          "minimum": 0
        },
        "mz": {
          "type": "number"
        }
      }
    },
    "distributedForceLoad": {
      "type": "object",
      "additionalProperties": false,
      "description": "Distributed force load over a non-zero span. x_end should be greater than x_start.",
      "required": [
        "type",
        "x_start",
        "x_end"
      ],
      "properties": {
        "type": {
          "const": "distributed_force"
        },
        "label": {
          "type": "string"
        },
        "x_start": {
          "type": "number",
          "minimum": 0
        },
        "x_end": {
          "type": "number",
          "minimum": 0
        },
        "qx": {
          "$ref": "#/$defs/linearValue"
        },
        "qy": {
          "$ref": "#/$defs/linearValue"
        }
      }
    },
    "distributedMomentLoad": {
      "type": "object",
      "additionalProperties": false,
      "description": "Distributed moment load over a non-zero span. x_end should be greater than x_start.",
      "required": [
        "type",
        "x_start",
        "x_end",
        "mz"
      ],
      "properties": {
        "type": {
          "const": "distributed_moment"
        },
        "label": {
          "type": "string"
        },
        "x_start": {
          "type": "number",
          "minimum": 0
        },
        "x_end": {
          "type": "number",
          "minimum": 0
        },
        "mz": {
          "$ref": "#/$defs/linearValue"
        }
      }
    },
    "load": {
      "oneOf": [
        {
          "$ref": "#/$defs/pointForceLoad"
        },
        {
          "$ref": "#/$defs/pointMomentLoad"
        },
        {
          "$ref": "#/$defs/distributedForceLoad"
        },
        {
          "$ref": "#/$defs/distributedMomentLoad"
        }
      ]
    }
  },
  "examples": [
    {
      "beam": {
        "length": 6,
        "section": {
          "Iy": 6e-06
        },
        "material": {
          "E": 210000000000
        }
      },
      "supports": [
        {
          "name": "A",
          "type": "pin",
          "x": 0
        },
        {
          "name": "B",
          "type": "roller_y",
          "x": 6
        }
      ],
      "loads": [
        {
          "type": "point_force",
          "label": "Center point load",
          "x": 3,
          "fy": -12
        }
      ],
      "analysis": {
        "stations": 31
      }
    }
  ]
}
