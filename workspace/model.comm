
# --- Code_Aster Beam Analysis (.comm) ---
DEBUT();

mesh = LIRE_MAILLAGE(FORMAT='UNV', UNITE=20);

model = AFFE_MODELE(
  MAILLAGE=mesh,
  AFFE=_F(GROUP_MA=('BEAM',), PHENOMENE='MECANIQUE', MODELISATION='POU_D_E')
);

# --- Material definition ---
mat = DEFI_MATERIAU(ELAS=_F(E=11000000000.0, NU=0.3, RHO=480.0));

chmat = AFFE_MATERIAU(
  MAILLAGE=mesh,
  AFFE=_F(GROUP_MA=('BEAM',), MATER=mat)
);

# --- Beam section geometry (RECTANGLE) ---
cara = AFFE_CARA_ELEM(
  MODELE=model,
  POUTRE=_F(GROUP_MA=('BEAM',),
            SECTION='RECTANGLE',
            CARA=('HY','HZ'),
            VALE=(0.12, 0.1)
			)
);

# --- Boundary condition (BASE fixed) ---
bc = AFFE_CHAR_CINE(
  MODELE=model,
  MECA_IMPO=_F(GROUP_NO=('BASE',),
               DX=0.0, DY=0.0, DZ=0.0,
               DRX=0.0, DRY=0.0, DRZ=0.0)
);

# --- Load (Nodal Force on TIP) ---
load = AFFE_CHAR_MECA(
  MODELE=model,
  FORCE_NODALE=_F(GROUP_NO=('TIP',), FY=-1500.0)
);

# --- Static analysis ---
res = MECA_STATIQUE(
  MODELE=model,
  CHAM_MATER=chmat,
  CARA_ELEM=cara,
  EXCIT=(_F(CHARGE=bc), _F(CHARGE=load))
);

# --- Print displacement field ---
IMPR_RESU(
  FORMAT='RESULTAT',
  UNITE=80,
  RESU=_F(RESULTAT=res, NOM_CHAM='DEPL')
);

FIN();
