# ____________ Printing tables displacements _______________

# ___________ Delete tables ______________

DETRUIRE(CONCEPT = _F(NOM = (tRQ2, tF1dQ2, tDQ2)), INFO=1) 

# __________ Printing the field contaning the LCS ___________
IMPR_CONCEPT(CONCEPT = _F(CARA_ELEM=cara,
		MODELE = model,
		REPERE_LOCAL = 'ELEM'),
		FORMAT = 'RESULTAT',
		UNITE = 53)
# ___________________________ Fin __________________________
FIN()
